# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tool state
.superpowers/
.claude/

# docs
docs/

# seed dumps (large, shared outside git)
db/seed_personas_chunks_*.sql

# local planning notes (next-steps.md, next-steps-*.md, ...)
next-steps*

# Phase 4 evaluation harness (spec §29.2): local runs, recordings, spend.
/eval/runs/
/eval/lookups/
/eval/budget.json
/eval/questions.draft.json

# Phase 5 evaluation reports (local only, never committed)
/evaluation-reports/

# presentation deck (local only)
presentation/
