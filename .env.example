OPENROUTER_API_KEY=''
DATABASE_URL='postgres://persona:persona@localhost:5433/persona'
# Staging (spec §31): Neon's direct URL, used only by the schema step in the Vercel build. Empty in dev.
DATABASE_URL_UNPOOLED=''
# Optional. Max connections per app instance; default 10. Staging: 5.
DATABASE_POOL_MAX=''

# Optional. Defaults: anthropic/claude-haiku-5.5 (persona agent), deepseek/deepseek-v4.1-flash (classifier,
# query expansion, fact-check, profiles, and recall beyond the biography).
AGENT_MODEL=''
HELPER_MODEL=''
RECALL_MODEL=''
# Optional. The persona agent's reasoning effort (none, minimal, low, medium, high). Default: low (spec §20.1).
AGENT_REASONING_EFFORT=''
# Optional. A reasoning budget in tokens for the persona agent, used instead of the effort above when that
# is empty (spec §28.2). A positive integer; anything else is ignored. Default: the code's constant.
AGENT_REASONING_MAX_TOKENS=''

# Accounts (spec §24.8). Required.
# Any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=''
BETTER_AUTH_URL='http://localhost:3000'
# Optional in dev: without a key, codes and emails print to the server console.
RESEND_API_KEY=''
EMAIL_FROM=''
# Cloudflare Turnstile. Dev: the always-pass test keys below.
NEXT_PUBLIC_TURNSTILE_SITE_KEY='1x00000000000000000000AA'
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'
# Required in production (e.g. x-real-ip, cf-connecting-ip): the header your proxy sets to the real client IP.
# Optional in dev (default x-forwarded-for).
AUTH_IP_HEADER=''
